node_modules/
dist/
.astro/
.DS_Store
*.log
.env
.env.*

# Local agent configuration and generated skill metadata
.agents/
.cursor/
skills-lock.json

# Synced site assets — regenerated by pnpm chronicle sync
site/src/content/events/*
!site/src/content/events/.gitkeep
site/public/events/*
!site/public/events/.gitkeep

# Raw media dumps — curate via gallery in event.yaml
# For CI deploys, copy selected photos to published/gallery/ instead
events/*/sources/slides/*
!events/*/sources/slides/.gitkeep
events/*/sources/images/*
!events/*/sources/images/.gitkeep

# AI drafts — ephemeral working files
events/*/drafts/*
!events/*/drafts/.gitkeep
