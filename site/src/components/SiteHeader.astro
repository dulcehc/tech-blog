---
import { siteUrl } from "../lib/format";
import PageColumn from "./PageColumn.astro";

interface Props {
  year?: string;
  backHref?: string;
  backLabel?: string;
}

const { year, backHref, backLabel = "CDMX Tech Journal" } = Astro.props;
---

<PageColumn>
  <header class="flex min-h-16 items-end justify-between gap-4 border-b border-rule pt-6 pb-3">
    <a
      href={siteUrl()}
      class="font-serif text-xl tracking-tight text-ink no-underline transition-colors duration-200 hover:text-accent focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-accent/40"
    >
      {backLabel}
    </a>
    {year && (
      <a
        href={siteUrl(`${year}/`)}
        class="font-mono text-[0.65rem] tracking-[0.14em] text-muted uppercase no-underline transition-colors duration-200 hover:text-accent focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-accent/40"
      >
        {year}
      </a>
    )}
    {backHref && !year && (
      <a
        href={backHref}
        class="font-mono text-[0.65rem] tracking-[0.14em] text-muted uppercase no-underline transition-colors duration-200 hover:text-accent focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-accent/40"
      >
        Back
      </a>
    )}
  </header>
</PageColumn>
