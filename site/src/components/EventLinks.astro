---
interface Props {
  links?: {
    event?: string;
    slides?: string;
    video?: string;
    repo?: string;
  };
}

const { links } = Astro.props;

const items = [
  { href: links?.event, label: "Event page" },
  { href: links?.slides, label: "Slides" },
  { href: links?.video, label: "Video" },
  { href: links?.repo, label: "Repository" },
].filter((item): item is { href: string; label: string } => Boolean(item.href));
---

{items.length > 0 && (
  <nav class="flex flex-wrap gap-3" aria-label="Related links">
    {items.map((item) => (
      <a
        href={item.href}
        target="_blank"
        rel="noopener noreferrer"
        class="font-mono text-[0.75rem] tracking-wide text-accent underline decoration-1 underline-offset-4 focus-visible:outline-3 focus-visible:outline-offset-3 focus-visible:outline-accent/40"
      >
        {item.label} ↗
      </a>
    ))}
  </nav>
)}
