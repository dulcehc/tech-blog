---
interface Props {
  items: string[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

{items.length > 0 && (
  <ul class:list={["m-0 flex list-none flex-wrap gap-2 p-0", className]}>
    {items.map((item) => (
      <li class="border border-rule px-2 py-0.5 font-mono text-[0.7rem] tracking-wide text-ink">
        {item}
      </li>
    ))}
  </ul>
)}
